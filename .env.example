# คัดลอกเป็น .env แล้วกรอกค่า (ถ้าไม่ใส่ APPS_SCRIPT_URL ระบบจะใช้ข้อมูลในหน่วยความจำสำหรับทดสอบ)
PORT=3000
ADMIN_PASSWORD=change-me
JWT_SECRET=ใส่ข้อความสุ่มยาวๆ
# URL ของ Web app จาก Apps Script (ลงท้ายด้วย /exec)
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
# ลิงก์ LINE ร้าน (สำรองไว้ให้ปุ่มติดต่อใช้ได้แม้เซิร์ฟเวอร์ล่ม) — ใส่แล้วต้อง build ใหม่
VITE_LINE_URL=https://line.me/R/ti/p/@yourshop
